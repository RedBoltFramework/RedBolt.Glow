<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>
  <ItemGroup>
    <_RedBoltExternalDesktopProject Include="../Native/RedBolt.Glow.Native.csproj;../Native/XAtlas/RedBolt.Bindings.XAtlas.csproj;../Native/Embree/RedBolt.Bindings.Embree.csproj;../Glow/RedBolt.Glow.csproj" Condition="'$(RedBoltGlowEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="../Glow.Tools/RedBolt.Glow.Tools.csproj" Condition="'$(RedBoltGlowEnabled)' == 'true' and ('$(RedBoltEditorEnabled)' == 'true' or '$(RedBoltTestsEnabled)' == 'true')" />
    <_RedBoltExternalDesktopProject Include="../Glow.Editor/RedBolt.Glow.Editor.csproj" Condition="'$(RedBoltGlowEnabled)' == 'true' and '$(RedBoltEditorEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="../Sample/BakedLighting/RedBolt.Sample.BakedLighting.csproj" Condition="'$(RedBoltGlowEnabled)' == 'true' and '$(RedBoltSamplesEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="$(RedBoltTestsProject)" Condition="'$(RedBoltTestsEnabled)' == 'true' and Exists('$(RedBoltTestsProject)')" />
  </ItemGroup>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/Build.targets" />
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.Bindings.XAtlas</AssemblyName>
    <EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup Condition="'$(RedBoltGeneratedBindingsDir)' != '' and Exists('$(RedBoltGeneratedBindingsDir)/xatlas')">
    <Compile Include="$(RedBoltGeneratedBindingsDir)/xatlas/**/*.g.cs" LinkBase="Generated" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Core/RedBolt.Core.csproj" />
    <Compile Include="$(RedBoltRoot)/src/RedBolt/Core/GlobalAliases.cs" Link="GlobalAliases.cs" Visible="false" />
  </ItemGroup>

</Project>

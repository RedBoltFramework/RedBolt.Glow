<Project>
  <!--
    Module project evaluation. Native module with generator, bindings, and exact native targets.
  -->
  <PropertyGroup>
    <RedBoltGlowRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RedBoltGlowRoot>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltGlowRoot)/../RedBolt'))</RedBoltRoot>
    <RedBoltExternalModuleRoot>$(RedBoltGlowRoot)</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.Glow</RedBoltExternalModuleName>
    <RedBoltExternalGeneratorProjectName>RedBolt.Glow.Generator.Dependencies</RedBoltExternalGeneratorProjectName>
    <RedBoltExternalGeneratorProjectPrefix>RedBolt.Glow.Generator.</RedBoltExternalGeneratorProjectPrefix>
    <RedBoltExternalGeneratedBindingsDirectory>redbolt-glow-native</RedBoltExternalGeneratedBindingsDirectory>
    <RedBoltExternalHasNative>true</RedBoltExternalHasNative>
    <RedBoltAndroidSupported>false</RedBoltAndroidSupported>
    <RedBoltExternalNativeTargetPrefix>redbolt-glow</RedBoltExternalNativeTargetPrefix>
    <RedBoltExternalEnabledNativeModules>GLOW</RedBoltExternalEnabledNativeModules>
    <RedBoltExternalDesktopResourceRoot>$(RedBoltGlowRoot)</RedBoltExternalDesktopResourceRoot>
    <RedBoltExternalDesktopResourceName>Glow</RedBoltExternalDesktopResourceName>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/eng/RedBolt.ModuleBuild/Directory.Build.props" />
</Project>
